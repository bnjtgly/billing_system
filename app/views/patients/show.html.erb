<% content_for :title, (@patient.present? ? "Patient • #{@patient.last_name}, #{@patient.first_name}" : "Patient") %>

<div class="max-w-6xl mx-auto px-4 py-6 space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 text-green-700 border border-green-200 mb-2 rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <!-- Header / Profile card -->
  <div class="bg-white rounded-xl shadow p-6 flex items-center gap-4">
    <div class="h-16 w-16 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-2xl font-semibold">
      <% initials = [@patient.first_name, @patient.last_name].map { |n| n.to_s.first }.join.upcase %>
      <%= initials.presence || "?" %>
    </div>
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-semibold text-gray-900 mr-2 truncate">
          <%= [@patient.first_name, @patient.last_name].compact.join(' ').presence || 'Unnamed Patient' %>
        </h1>
        <% if @patient.gender.present? %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= @patient.gender.to_s.titleize %></span>
        <% end %>
        <% if @patient.date_of_birth.present? %>
          <% dob = @patient.date_of_birth; now = Date.current; age = now.year - dob.year - ((now.month > dob.month || (now.month == dob.month && now.day >= dob.day)) ? 0 : 1) %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-700"><%= age %> yrs</span>
        <% end %>
      </div>
      <div class="mt-1 text-sm text-gray-600 flex flex-col sm:flex-row sm:items-center gap-2">
        <% if @patient.email.present? %>
          <span class="truncate">📧 <%= @patient.email %></span>
        <% end %>
        <% if @patient.phone_number.present? %>
          <span class="truncate">📱 <%= @patient.phone_number %></span>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_patient_path(@patient), class: "btn btn-secondary" %>
      <%= link_to "Back", patients_path, class: "btn btn-outline" %>
      <%= button_to "Delete", @patient, method: :delete, form_class: "btn btn-error text-white", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Details -->
    <div class="lg:col-span-1">
      <div class="bg-white rounded-xl shadow p-6">
        <h2 class="text-lg font-semibold text-gray-900 mb-4">Patient Details</h2>
        <dl class="divide-y divide-gray-100">
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">First name</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2"><%= @patient.first_name %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">Last name</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2"><%= @patient.last_name %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">Date of birth</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2"><%= @patient.date_of_birth&.strftime('%b %d, %Y') %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">Gender</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2"><%= @patient.gender %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">Email</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2 break-words"><%= @patient.email %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">Phone</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2 break-words"><%= @patient.phone_number %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">Address</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2 break-words"><%= @patient.address %></dd>
          </div>
          <div class="py-3 grid grid-cols-3 gap-4">
            <dt class="text-sm font-medium text-gray-500">City</dt>
            <dd class="mt-0 text-sm text-gray-900 col-span-2"><%= @patient.city %></dd>
          </div>
        </dl>
      </div>
    </div>

    <!-- Activity / Related Records -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Recent Billings -->
      <% if admin_user? %>
        <div class="bg-white rounded-xl shadow p-6">
          <div class="flex items-center justify-between mb-4">
            <h2 class="text-lg font-semibold text-gray-900">Recent Bills</h2>
            <%= link_to "View all", billings_path(q: @patient.complete_name), class: "text-sm text-indigo-600 hover:text-indigo-700" %>
          </div>
          <% if @billings.present? %>
            <div class="overflow-x-auto">
              <table class="min-w-full divide-y divide-gray-200">
                <thead>
                <tr class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                  <th class="px-3 py-2">Statement #</th>
                  <th class="px-3 py-2">Statement Date</th>
                  <th class="px-3 py-2">Period</th>
                  <th class="px-3 py-2">Status</th>
                  <th class="px-3 py-2 text-right">Total</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                <% @billings.each do |b| %>
                  <tr class="text-sm text-gray-700">
                    <td class="px-3 py-2 font-medium text-indigo-700"><%= link_to b.statement_number, billing_path(b), class: "hover:underline" %></td>
                    <td class="px-3 py-2"><%= b.statement_date&.strftime('%b %d, %Y') %></td>
                    <td class="px-3 py-2">
                      <% if b.period_start || b.period_end %>
                        <%= [b.period_start&.strftime('%b %d, %Y'), b.period_end&.strftime('%b %d, %Y')].compact.join(' – ') %>
                      <% end %>
                    </td>
                    <td class="px-3 py-2">
                      <% status_color = b.status == "issued" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700" %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_color %>"><%= b.status.to_s.titleize %></span>
                    </td>
                    <td class="px-3 py-2 text-right">
                      <%= number_to_currency((b.total_cents || 0) / 100.0, unit: "₱") %>
                    </td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <p class="text-sm text-gray-500">No bills yet.</p>
          <% end %>
        </div>
      <% end %>

      <!-- Recent Checklists -->
      <div class="bg-white rounded-xl shadow p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-gray-900">Recent Checklists</h2>
          <%= link_to "View all", charge_checklists_path(q: @patient.complete_name), class: "text-sm text-indigo-600 hover:text-indigo-700" %>
        </div>
        <% if @checklists.present? %>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead>
                <tr class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                  <th class="px-3 py-2">Performed On</th>
                  <th class="px-3 py-2">Issued</th>
                  <th class="px-3 py-2">Notes</th>
                  <th class="px-3 py-2"></th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                <% @checklists.each do |c| %>
                  <tr class="text-sm text-gray-700">
                    <td class="px-3 py-2"><%= c.performed_on&.strftime('%b %d, %Y') %></td>
                    <td class="px-3 py-2">
                      <% issued = c.issued.to_s %>
                      <% issued_badge = issued.present? && issued.downcase == 'yes' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= issued_badge %>"><%= issued.presence || '—' %></span>
                    </td>
                    <td class="px-3 py-2 truncate max-w-xs"><%= c.notes.to_s.presence || '—' %></td>
                    <td class="px-3 py-2 text-right">
                      <%= link_to 'Open', charge_checklist_path(c), class: 'text-indigo-600 hover:text-indigo-700' %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">No checklists yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
