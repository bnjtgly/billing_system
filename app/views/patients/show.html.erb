<% content_for :title, "Showing patient" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing patient</h1>

  <%= render @patient %>

  <%= link_to "Edit", edit_patient_path(@patient), class: "btn btn-secondary" %>
  <%= link_to "Back", patients_path, class: "btn btn-outline" %>
  <%= button_to "Delete", @patient, method: :delete, form_class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
</div>
