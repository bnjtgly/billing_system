<%= form_with(model: patient, class: "contents") do |form| %>
  <% if patient.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(patient.errors.count, "error") %> prohibited this patient from being saved:</h2>

      <ul class="list-disc ml-6">
        <% patient.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :first_name %>
    <%= form.text_field :first_name, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:first_name].none?, "border-red-400 focus:outline-red-600": patient.errors[:first_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :last_name %>
    <%= form.text_field :last_name, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:last_name].none?, "border-red-400 focus:outline-red-600": patient.errors[:last_name].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :date_of_birth %>
    <%= form.date_field :date_of_birth, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:date_of_birth].none?, "border-red-400 focus:outline-red-600": patient.errors[:date_of_birth].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :gender %>
    <%= form.select :gender,
                    [["Female","female"], ["Male","male"]],
                    { include_blank: "Select..." },
                    class: ["select select-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:gender].none?, "border-red-400 focus:outline-red-600": patient.errors[:gender].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :email %>
    <%= form.text_field :email, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:email].none?, "border-red-400 focus:outline-red-600": patient.errors[:email].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :phone_number %>
    <%= form.telephone_field :phone_number, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:phone_number].none?, "border-red-400 focus:outline-red-600": patient.errors[:phone_number].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :address %>
    <%= form.textarea :address, rows: 4, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:address].none?, "border-red-400 focus:outline-red-600": patient.errors[:address].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :city %>
    <%= form.text_field :city, class: ["input input-bordered w-full", {"border-gray-400 focus:outline-blue-600": patient.errors[:city].none?, "border-red-400 focus:outline-red-600": patient.errors[:city].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
