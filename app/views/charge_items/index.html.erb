<% content_for :title, "Charge items" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Charge items</h1>
    <%= link_to "New charge item", new_charge_item_path, class: "btn btn-primary shadow-md" %>
  </div>

  <div id="charge_items" class="min-w-full divide-y divide-gray-200 space-y-5 mt-8">
    <% if @charge_items.any? %>
      <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
        <table class="min-w-full text-sm text-gray-900">
          <thead class="bg-gray-50">
          <tr class="text-left text-gray-700">
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Name</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Category</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Unit</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Default price</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Position</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Active</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold text-right">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
          <%= render partial: "charge_items/charge_item_row", collection: @charge_items, as: :charge_item %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10">No charge items found.</p>
    <% end %>
  </div>
</div>
