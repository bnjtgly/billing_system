<% content_for :title, (@charge_category.present? ? "Category • #{@charge_category.name}" : "Category") %>

<div class="max-w-5xl mx-auto px-4 py-6 space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 text-green-700 border border-green-200 mb-2 rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-start justify-between">
    <div class="min-w-0">
      <h1 class="text-xl font-semibold text-gray-900">Charge Category</h1>
      <div class="mt-1 text-sm text-gray-600">
        <%= @charge_category.name %>
        <% if @charge_category.key.present? %>
          <span class="ml-2 inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700"><%= @charge_category.key %></span>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_charge_category_path(@charge_category), class: "btn btn-secondary" %>
      <%= link_to "Back", charge_categories_path, class: "btn btn-outline" %>
      <%= button_to "Delete", @charge_category, method: :delete, form_class: "btn btn-error text-white", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Details</h2>
    <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
      <div>
        <dt class="text-xs text-gray-500">Name</dt>
        <dd class="text-sm text-gray-900"><%= @charge_category.name %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Key</dt>
        <dd class="text-sm text-gray-900"><%= @charge_category.key %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Position</dt>
        <dd class="text-sm text-gray-900"><%= @charge_category.position %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Items</dt>
        <dd class="text-sm text-gray-900"><%= @charge_category.charge_items.count %></dd>
      </div>
    </dl>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Items in this category</h2>
      <%= link_to "New Item", new_charge_item_path, class: "text-sm text-indigo-600 hover:text-indigo-700" %>
    </div>
    <% if @charge_category.charge_items.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-700">
            <tr>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Name</th>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Unit</th>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Default Price</th>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Active</th>
              <th class="px-3 py-2 text-right uppercase tracking-wide text-xs font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @charge_category.charge_items.each do |item| %>
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2 font-medium text-indigo-700"><%= link_to item.name, item, class: 'hover:underline' %></td>
                <td class="px-3 py-2"><%= item.unit %></td>
                <td class="px-3 py-2"><%= number_to_currency(item.default_price_cents.to_i / 100.0, unit: "₱") %></td>
                <td class="px-3 py-2">
                  <% badge = item.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= badge %>"><%= item.active ? 'Active' : 'Inactive' %></span>
                </td>
                <td class="px-3 py-2 text-right">
                  <%= link_to 'Open', item, class: 'text-indigo-600 hover:text-indigo-700' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No items in this category.</p>
    <% end %>
  </div>
</div>
