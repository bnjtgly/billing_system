<% content_for :title, "Showing charge category" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing charge category</h1>

  <%= render @charge_category %>

  <%= link_to "Edit this charge category", edit_charge_category_path(@charge_category), class: "btn btn-secondary" %>
  <%= link_to "Back to charge categories", charge_categories_path, class: "btn btn-outline" %>
  <%= button_to "Destroy this charge category", @charge_category, method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
</div>
