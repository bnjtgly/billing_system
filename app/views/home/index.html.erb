<% content_for :title, "Dashboard" %>

<div class="max-w-7xl mx-auto px-0 sm:px-0 space-y-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-semibold">Dashboard</h1>
      <p class="text-sm text-gray-500">Overview of patients, billing, and checklists</p>
    </div>
    <div class="hidden sm:flex items-center gap-2">
      <%= link_to "New Billing", new_billing_path, class: "btn btn-accent shadow" %>
      <%= link_to "New charge checklist", new_charge_checklist_path, class: "btn btn-primary shadow" %>
      <%= link_to "New Patient", new_patient_path, class: "btn btn-outline" %>
    </div>
  </div>

  <% total_patients = Patient.count %>
  <% issued_bills = Billing.respond_to?(:issued) ? Billing.issued.count : Billing.where(status: "issued").count %>
  <% draft_bills = Billing.respond_to?(:draft) ? Billing.draft.count : Billing.where(status: "draft").count %>
  <% month_range = Date.current.beginning_of_month..Date.current.end_of_month %>
  <% revenue_this_month_cents = Billing.respond_to?(:issued) ? Billing.issued.where(statement_date: month_range).sum(:total_cents) : Billing.where(status: "issued", statement_date: month_range).sum(:total_cents) %>
  <% checklists_this_week = ChargeChecklist.where(performed_on: Date.current.beginning_of_week..Date.current.end_of_week).count %>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <div class="bg-white rounded-xl shadow p-5 border border-gray-200">
      <div class="text-sm text-gray-500">Patients</div>
      <div class="mt-1 text-2xl font-semibold text-gray-900"><%= total_patients %></div>
      <div class="mt-2 text-xs text-gray-500">Total registered</div>
    </div>
    <div class="bg-white rounded-xl shadow p-5 border border-gray-200">
      <div class="text-sm text-gray-500">Bills (Issued)</div>
      <div class="mt-1 text-2xl font-semibold text-gray-900"><%= issued_bills %></div>
      <div class="mt-2 text-xs text-green-700">Processed</div>
    </div>
    <div class="bg-white rounded-xl shadow p-5 border border-gray-200">
      <div class="text-sm text-gray-500">Bills (Draft)</div>
      <div class="mt-1 text-2xl font-semibold text-gray-900"><%= draft_bills %></div>
      <div class="mt-2 text-xs text-yellow-700">Pending</div>
    </div>
    <div class="bg-white rounded-xl shadow p-5 border border-gray-200">
      <div class="text-sm text-gray-500">Revenue (This month)</div>
      <div class="mt-1 text-2xl font-semibold text-gray-900"><%= number_to_currency((revenue_this_month_cents || 0) / 100.0) %></div>
      <div class="mt-2 text-xs text-gray-500">From issued bills</div>
    </div>
  </div>

  <!-- Quick links -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
    <%= link_to charge_checklists_path, class: "group rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition" do %>
      <div class="text-gray-900 font-medium">Charge Checklists</div>
      <p class="text-sm text-gray-500 mt-1">View and manage charge checklists</p>
    <% end %>

    <%= link_to charge_categories_path, class: "group rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition" do %>
      <div class="text-gray-900 font-medium">Categories</div>
      <p class="text-sm text-gray-500 mt-1">Configure sections</p>
    <% end %>

    <%= link_to charge_items_path, class: "group rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition" do %>
      <div class="text-gray-900 font-medium">Items</div>
      <p class="text-sm text-gray-500 mt-1">Manage checklist items</p>
    <% end %>

    <%= link_to medicines_path, class: "group rounded-xl border border-gray-200 bg-white p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition" do %>
      <div class="text-gray-900 font-medium">Medicines</div>
      <p class="text-sm text-gray-500 mt-1">Medicine catalog</p>
    <% end %>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    <!-- Recent bills -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-4 py-2 border-b font-semibold flex items-center justify-between">
        <span>Recent bills</span>
        <%= link_to "New Billing", new_billing_path, class: "text-sm text-indigo-600 hover:text-indigo-700" %>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-700">
          <tr>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Statement #</th>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Patient</th>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Date</th>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Status</th>
            <th class="px-3 py-2 text-right uppercase tracking-wide text-xs font-semibold">Total</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
          <% Billing.order(statement_date: :desc, created_at: :desc).limit(8).each do |b| %>
            <tr class="hover:bg-gray-50">
              <td class="px-3 py-2 whitespace-nowrap font-medium text-indigo-700"><%= link_to b.statement_number, billing_path(b), class: "hover:underline" %></td>
              <td class="px-3 py-2 whitespace-nowrap"><%= [b.patient&.first_name, b.patient&.last_name].compact.join(" ") %></td>
              <td class="px-3 py-2 whitespace-nowrap"><%= defined?(l) ? l(b.statement_date) : b.statement_date %></td>
              <td class="px-3 py-2 whitespace-nowrap">
                <% status_color = b.status == "issued" ? "bg-green-100 text-green-700" : "bg-yellow-100 text-yellow-700" %>
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium <%= status_color %>"><%= b.status.to_s.titleize %></span>
              </td>
              <td class="px-3 py-2 whitespace-nowrap text-right"><%= number_to_currency((b.total_cents || 0) / 100.0) %></td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent checklists -->
    <div class="bg-white rounded-lg border border-gray-200 shadow-sm overflow-hidden">
      <div class="px-4 py-2 border-b font-semibold flex items-center justify-between">
        <span>Recent charge checklists</span>
        <%= link_to "New Checklist", new_charge_checklist_path, class: "text-sm text-indigo-600 hover:text-indigo-700" %>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-700">
          <tr>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Patient</th>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Performed on</th>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Items</th>
            <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Notes</th>
            <th class="px-3 py-2 text-right uppercase tracking-wide text-xs font-semibold">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
          <% ChargeChecklist.order(performed_on: :desc).limit(8).each do |cc| %>
            <tr class="hover:bg-gray-50">
              <td class="px-3 py-2 whitespace-nowrap"><%= [cc.patient&.first_name, cc.patient&.last_name].compact.join(" ") %></td>
              <td class="px-3 py-2 whitespace-nowrap"><%= defined?(l) ? l(cc.performed_on) : cc.performed_on %></td>
              <td class="px-3 py-2 whitespace-nowrap"><%= cc.line_items.size %></td>
              <td class="px-3 py-2 truncate max-w-[18rem]" title="<%= cc.notes %>"><%= cc.notes %></td>
              <td class="px-3 py-2">
                <div class="flex justify-end gap-1.5">
                  <%= link_to cc, class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900", title: "Show" do %>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.04 12.32a11.45 11.45 0 0 1 19.92 0 11.45 11.45 0 0 1-19.92 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>
                  <% end %>
                  <%= link_to edit_charge_checklist_path(cc), class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900", title: "Edit" do %>
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 3.487a2.1 2.1 0 0 1 2.97 2.97L8.25 18.04 4.5 19.5l1.46-3.75 10.902-12.263z"/></svg>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>