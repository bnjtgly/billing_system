<% content_for :title, "Charge checklists" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Charge checklists</h1>
    <%= link_to "New charge checklist", new_charge_checklist_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="charge_checklists" class="min-w-full divide-y divide-gray-200 space-y-5 mt-8">
    <% if @charge_checklists.any? %>
      <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
        <table class="min-w-full text-sm text-gray-900">
          <thead class="bg-gray-50">
          <tr class="text-left text-gray-700">
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Patient</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Performed on</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Line items</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Notes</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold text-right">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
          <%= render partial: "charge_checklists/charge_checklist_row", collection: @charge_checklists, as: :charge_checklist %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10">No charge checklists found.</p>
    <% end %>
  </div>
</div>
