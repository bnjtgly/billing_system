<div id="<%= dom_id charge_checklist %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Patient:</strong>
    <%= charge_checklist.patient_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Performed on:</strong>
    <%= charge_checklist.performed_on %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Issued By:</strong>
    <%= "#{charge_checklist.user&.complete_name}" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Transaction:</strong>
    <%= "#{charge_checklist.issued}" %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Notes:</strong>
    <%= charge_checklist.notes %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Metadata:</strong>
    <%= charge_checklist.metadata %>
  </div>
</div>
