<% title_patient = [@charge_checklist.patient&.last_name, @charge_checklist.patient&.first_name].compact.join(', ') %>
<% content_for :title, (title_patient.present? ? "Checklist • #{title_patient}" : "Checklist") %>

<div class="max-w-5xl mx-auto px-4 py-6 space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 text-green-700 border border-green-200 mb-2 rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-start justify-between">
    <div class="min-w-0">
      <h1 class="text-xl font-semibold text-gray-900">Charge Checklist</h1>
      <div class="mt-1 text-sm text-gray-600 flex flex-wrap gap-x-3 gap-y-1">
        <% if @charge_checklist.performed_on.present? %>
          <span>Performed: <%= @charge_checklist.performed_on.strftime('%b %d, %Y') %></span>
        <% end %>
        <% issued = @charge_checklist.issued.to_s %>
        <% issued_badge = issued.present? && issued.downcase == 'issued' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= issued_badge %>"><%= issued.presence || 'Draft' %></span>
        <% if @charge_checklist.patient.present? %>
          <span>Patient: <%= link_to [@charge_checklist.patient.first_name, @charge_checklist.patient.last_name].compact.join(' '), @charge_checklist.patient, class: 'text-indigo-700 hover:underline' %></span>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_charge_checklist_path(@charge_checklist), class: "btn btn-secondary" %>
      <%= link_to "Back", charge_checklists_path, class: "btn btn-outline" %>
      <%= button_to "Delete", @charge_checklist, method: :delete, form_class: "btn btn-error text-white", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Details</h2>
    <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
      <div>
        <dt class="text-xs text-gray-500">Performed on</dt>
        <dd class="text-sm text-gray-900"><%= @charge_checklist.performed_on&.strftime('%b %d, %Y') || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Issued</dt>
        <dd class="text-sm text-gray-900"><%= @charge_checklist.issued.to_s.presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Patient</dt>
        <dd class="text-sm text-indigo-700">
          <% if @charge_checklist.patient %>
            <%= link_to [@charge_checklist.patient.first_name, @charge_checklist.patient.last_name].compact.join(' '), @charge_checklist.patient, class: 'hover:underline' %>
          <% else %>
            —
          <% end %>
        </dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Created by</dt>
        <dd class="text-sm text-gray-900"><%= [@charge_checklist.user&.first_name, @charge_checklist.user&.last_name].compact.join(' ').presence || '—' %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-gray-500">Notes</dt>
        <dd class="text-sm text-gray-900"><%= @charge_checklist.notes.to_s.presence || '—' %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Items</dt>
        <dd class="text-sm text-gray-900"><%= @charge_checklist.line_items.size %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Total</dt>
        <% total_cents = @charge_checklist.line_items.sum(:total_cents) %>
        <dd class="text-sm text-gray-900"><%= number_to_currency(total_cents.to_i / 100.0, unit: "₱") %></dd>
      </div>
    </dl>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Line Items</h2>
    </div>
    <% if @charge_checklist.line_items.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-700">
            <tr>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Item</th>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Dosage</th>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Freq</th>
              <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Route</th>
              <th class="px-3 py-2 text-right uppercase tracking-wide text-xs font-semibold">Qty</th>
              <th class="px-3 py-2 text-right uppercase tracking-wide text-xs font-semibold">Unit Price</th>
              <th class="px-3 py-2 text-right uppercase tracking-wide text-xs font-semibold">Total</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @charge_checklist.line_items.each do |li| %>
              <tr class="hover:bg-gray-50">
                <td class="px-3 py-2"><span class="text-gray-900"><%= li.display_name %></span><span class="ml-2 text-xs text-gray-500"><%= li.display_item_code %></span></td>
                <td class="px-3 py-2"><%= li.display_dosage %></td>
                <td class="px-3 py-2"><%= li.display_frequency %></td>
                <td class="px-3 py-2"><%= li.display_route %></td>
                <td class="px-3 py-2 text-right"><%= li.quantity %></td>
                <td class="px-3 py-2 text-right"><%= number_to_currency(li.unit_price_cents.to_i / 100.0, unit: "₱") %></td>
                <td class="px-3 py-2 text-right"><%= number_to_currency(li.total_cents.to_i / 100.0, unit: "₱") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-sm text-gray-500">No items added.</p>
    <% end %>
  </div>
</div>
