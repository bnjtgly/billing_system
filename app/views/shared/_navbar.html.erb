<% if defined?(authenticated?) && authenticated? %>
  <header class="sticky top-0 z-40 bg-white/90 backdrop-blur shadow-[0_2px_10px_rgba(0,0,0,0.15)]">
  <div class="max-w-7xl mx-auto px-4">
      <div class="h-14 flex items-center justify-between">
        <!-- Brand + desktop nav -->
        <div class="flex items-center gap-6">
          <%= link_to root_path, class: "flex items-center gap-2" do %>
            <img src="/icon.png"
                 alt="AMOSUP Logo"
                 class="h-6 w-auto object-contain align-middle block"
                 style="max-height: 1.5rem; filter: brightness(0) saturate(100%) invert(0%) sepia(0%) saturate(0%) hue-rotate(0deg);">
            <span class="text-base font-semibold tracking-tight text-gray-900">AMOSUP Billing</span>
          <% end %>

          <nav class="hidden md:flex items-center gap-2 text-sm">
            <%= link_to "Home", root_path,
                        class: "btn btn-ghost btn-md #{'btn-active' if current_page?(root_path)}" %>

            <%= link_to "Patients", patients_path,
                        class: "btn btn-ghost btn-md #{'btn-active' if current_page?(patients_path)}" %>

            <!-- Checklist dropdown -->
            <div class="dropdown dropdown-hover">
              <div tabindex="0" role="button" class="btn btn-ghost btn-md m-1">
                Checklist
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 ml-1 opacity-70" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd"/>
                </svg>
              </div>
              <ul tabindex="0" class="dropdown-content menu p-2 shadow bg-base-100 rounded-box w-52 z-50">
                <li><%= link_to "Charge", charge_checklists_path, class: "#{'active' if current_page?(charge_checklists_path)}" %></li>
                <li><%= link_to "Categories", charge_categories_path, class: "#{'active' if current_page?(charge_categories_path)}" %></li>
                <li><%= link_to "Items", charge_items_path, class: "#{'active' if current_page?(charge_items_path)}" %></li>
              </ul>
            </div>

            <%= link_to "Medicines", medicines_path,
                        class: "btn btn-ghost btn-md #{'btn-active' if current_page?(medicines_path)}" %>

            <% if admin_user? %>
              <%= link_to "Billing", (respond_to?(:billings_path) ? billings_path : '#'),
                          class: "btn btn-ghost btn-md #{'btn-active' if defined?(billings_path) && current_page?(billings_path)}" %>
            <% end %>
          </nav>
        </div>

        <!-- Auth -->
        <div class="hidden md:flex items-center gap-3">
          <% if defined?(authenticated?) && authenticated? %>
            <span class="text-sm text-gray-700">Signed in as <strong><%= Current.user.email_address %></strong></span>
            <%= button_to "Sign Out", session_path, method: :delete,
                          class: "btn btn-ghost" %>
          <% else %>
            <%= link_to "Sign In", (defined?(new_session_path) ? new_session_path : "#"),
                        class: "rounded-md px-3.5 py-1.5 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
          <% end %>
        </div>

        <!-- Mobile menu -->
        <details class="md:hidden">
          <summary class="list-none inline-flex items-center justify-center rounded-md p-2 hover:bg-gray-100 cursor-pointer">
            <svg class="w-5 h-5 text-gray-700" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </summary>
          <div class="mt-2 -mx-4 px-4 pb-3 border-t bg-white">
            <nav class="py-2 space-y-1 text-sm">
              <%= link_to "Home", root_path, class: "block rounded px-3 py-2 hover:bg-gray-50" %>
              <%= link_to "Patients", patients_path, class: "block rounded px-3 py-2 hover:bg-gray-50" %>

              <div class="px-3 pt-2 text-xs font-semibold text-gray-500 uppercase">Checklist</div>
              <%= link_to "Charge", charge_checklists_path, class: "block rounded px-3 py-2 hover:bg-gray-50" %>
              <%= link_to "Categories", charge_categories_path, class: "block rounded px-3 py-2 hover:bg-gray-50" %>
              <%= link_to "Items", charge_items_path, class: "block rounded px-3 py-2 hover:bg-gray-50" %>

              <%= link_to "Medicines", medicines_path, class: "block rounded px-3 py-2 hover:bg-gray-50" %>

              <% if admin_user? %>
                <%= link_to "Billing", (respond_to?(:billings_path) ? billings_path : "#"),
                            class: "block rounded px-3 py-2 hover:bg-gray-50" %>
              <% end %>

              <div class="border-t my-2"></div>

              <% if defined?(authenticated?) && authenticated? %>
                <%= button_to "Sign Out", session_path, method: :delete,
                              class: "w-full text-left rounded px-3 py-2 hover:bg-gray-50" %>
              <% else %>
                <%= link_to "Sign In", (defined?(new_session_path) ? new_session_path : "#"),
                            class: "block rounded px-3 py-2 hover:bg-gray-50" %>
              <% end %>
            </nav>
          </div>
        </details>
      </div>
    </div>
  </header>
<% end %>