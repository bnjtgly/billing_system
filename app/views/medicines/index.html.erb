<% content_for :title, "Medicines" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Medicines</h1>
    <%= link_to "New medicine", new_medicine_path, class: "rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium" %>
  </div>

  <div id="medicines" class="min-w-full divide-y divide-gray-200 space-y-5 mt-8">
    <% if @medicines.any? %>
      <div class="overflow-x-auto rounded-lg border border-gray-200 shadow-sm">
        <table class="min-w-full text-sm text-gray-900">
          <thead class="bg-gray-50">
          <tr class="text-left text-gray-700">
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Item code</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Drug name</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Generic name</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Form / Strength</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Unit</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold">Unit price</th>
            <th class="px-3 py-2 uppercase tracking-wide text-xs font-semibold text-right">Actions</th>
          </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
          <%= render partial: "medicines/medicine_row", collection: @medicines, as: :medicine %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-center my-10">No medicines found.</p>
    <% end %>
  </div>
</div>
