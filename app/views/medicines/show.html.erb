<% content_for :title, "Showing medicine" %>

<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <h1 class="font-bold text-4xl">Showing medicine</h1>

  <%= render @medicine %>

  <%= link_to "Edit this medicine", edit_medicine_path(@medicine), class: "btn btn-secondary" %>
  <%= link_to "Back to medicines", medicines_path, class: "btn btn-outline" %>
  <%= button_to "Destroy this medicine", @medicine, method: :delete, form_class: "btn btn-error", data: { turbo_confirm: "Are you sure?" } %>
</div>
