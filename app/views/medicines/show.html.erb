<% content_for :title, (@medicine.present? ? "Medicine • #{@medicine.drug_name}" : "Medicine") %>

<div class="max-w-5xl mx-auto px-4 py-6 space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 text-green-700 border border-green-200 mb-2 rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-start justify-between">
    <div class="min-w-0">
      <h1 class="text-xl font-semibold text-gray-900">Medicine</h1>
      <div class="mt-1 text-sm text-gray-600 flex flex-wrap gap-x-3 gap-y-1">
        <span><%= @medicine.drug_name %></span>
        <% if @medicine.item_code.present? %>
          <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700"><%= @medicine.item_code %></span>
        <% end %>
        <% badge = @medicine.active ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700' %>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium <%= badge %>"><%= @medicine.active ? 'Active' : 'Inactive' %></span>
      </div>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_medicine_path(@medicine), class: "btn btn-secondary" %>
      <%= link_to "Back", medicines_path, class: "btn btn-outline" %>
      <%= button_to "Delete", @medicine, method: :delete, form_class: "btn btn-error text-white", data: { turbo_confirm: "Are you sure?" } %>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Details</h2>
    <dl class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4">
      <div>
        <dt class="text-xs text-gray-500">Item code</dt>
        <dd class="text-sm text-gray-900 break-words"><%= @medicine.item_code %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Drug name</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.drug_name %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Generic name</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.generic_name %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Strength</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.strength %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Form</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.form %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Dosage</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.dosage %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Frequency</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.frequency %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Route</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.route %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Unit</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.unit %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Unit price</dt>
        <dd class="text-sm text-gray-900"><%= number_to_currency(@medicine.unit_price_cents.to_i / 100.0) %></dd>
      </div>
      <div>
        <dt class="text-xs text-gray-500">Quantity</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.qty %></dd>
      </div>
      <div class="sm:col-span-2">
        <dt class="text-xs text-gray-500">Notes</dt>
        <dd class="text-sm text-gray-900"><%= @medicine.notes %></dd>
      </div>
    </dl>
  </div>
</div>
