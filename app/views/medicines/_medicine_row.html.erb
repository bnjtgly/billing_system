<tr class="hover:bg-gray-50">
  <td class="px-4 py-3 align-middle whitespace-nowrap"><%= medicine.item_code %></td>
  <td class="px-4 py-3 align-middle whitespace-nowrap truncate max-w-[16rem]" title="<%= medicine.drug_name %>"><%= medicine.drug_name %></td>
  <td class="px-4 py-3 align-middle whitespace-nowrap truncate max-w-[14rem]" title="<%= medicine.generic_name %>"><%= medicine.generic_name %></td>
  <td class="px-4 py-3 align-middle whitespace-nowrap"><%= [medicine.form, medicine.strength].compact.join(" / ") %></td>
  <td class="px-4 py-3 align-middle whitespace-nowrap"><%= medicine.unit %></td>
  <td class="px-4 py-3 align-middle whitespace-nowrap">
    <%= number_to_currency(medicine.unit_price_cents.to_i / 100.0) %>
  </td>
  <td class="px-4 py-3 align-middle">
    <div class="flex justify-end gap-1.5">
      <%= link_to medicine,
                  class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900",
                  title: "Show", aria: { label: "Show" } do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M2.04 12.32a11.45 11.45 0 0 1 19.92 0 11.45 11.45 0 0 1-19.92 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
        </svg>
      <% end %>

      <%= link_to edit_medicine_path(medicine),
                  class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900",
                  title: "Edit", aria: { label: "Edit" } do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M16.862 3.487a2.1 2.1 0 0 1 2.97 2.97L8.25 18.04 4.5 19.5l1.46-3.75 10.902-12.263z"/>
        </svg>
      <% end %>

      <%= link_to medicine,
                  data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                  class: "inline-flex items-center justify-center rounded p-1.5 text-red-600 hover:bg-red-50",
                  title: "Destroy", aria: { label: "Destroy" } do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-9 0l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/>
        </svg>
      <% end %>
    </div>
  </td>
</tr>