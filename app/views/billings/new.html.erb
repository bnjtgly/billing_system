<% content_for :title, "New Billing" %>

<div class="max-w-4xl mx-auto space-y-6">
  <h1 class="text-2xl font-semibold">Create billing statement</h1>

  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <%= form_with url: new_billing_path, method: :get, local: true, class: "grid grid-cols-1 sm:grid-cols-3 gap-4" do %>
      <div class="sm:col-span-2">
        <label class="block text-sm font-medium mb-1">Patient</label>
        <%= select_tag :patient_id,
                       options_for_select(
                         @patients.map { |p| [ "#{p.last_name}, #{p.first_name}", p.id ] },
                         params[:patient_id]
                       ),
                       include_blank: "Select patient",
                       class: "w-full border rounded px-2 py-1" %>
      </div>
      <div class="flex items-end">
        <%= submit_tag "Load checklists", class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
      </div>
    <% end %>
  </div>

  <% if @patient %>
    <div class="rounded-lg border border-gray-200 bg-white">
      <div class="px-4 py-2 border-b font-semibold">Select charge checklists for <%= [@patient.first_name, @patient.last_name].join(" ") %></div>
      <div class="p-4">
        <%= form_with url: billings_path, method: :post, local: true, class: "space-y-4" do %>
          <%= hidden_field_tag "billing[patient_id]", @patient.id %>

          <% if @charge_checklists.any? %>
            <div class="overflow-x-auto rounded border">
              <table class="min-w-full text-sm">
                <thead class="bg-gray-50 text-gray-700">
                <tr>
                  <th class="px-3 py-2 w-10"></th>
                  <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Performed on</th>
                  <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Items</th>
                  <th class="px-3 py-2 text-left uppercase tracking-wide text-xs font-semibold">Notes</th>
                </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                <% @charge_checklists.each do |cc| %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-3 py-2">
                      <%= check_box_tag "billing[checklist_ids][]", cc.id, false, class: "rounded border-gray-300" %>
                    </td>
                    <td class="px-3 py-2 whitespace-nowrap"><%= defined?(l) ? l(cc.performed_on) : cc.performed_on %></td>
                    <td class="px-3 py-2"><%= cc.line_items.size %></td>
                    <td class="px-3 py-2 truncate max-w-[24rem]" title="<%= cc.notes %>"><%= cc.notes %></td>
                  </tr>
                <% end %>
                </tbody>
              </table>
            </div>
          <% else %>
            <div class="text-sm text-gray-600">No checklists for this patient.</div>
          <% end %>

          <div>
            <%= submit_tag "Generate billing", class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>