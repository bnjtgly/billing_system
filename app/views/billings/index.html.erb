<% content_for :title, "Billings" %>

<div class="max-w-7xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-2xl">Billings</h1>
    <div class="flex gap-2">
      <%= link_to "Create from checklists", new_from_checklists_billings_path, class: "rounded-md px-3.5 py-2 bg-blue-600 hover:bg-blue-500 text-white text-sm font-medium" %>
      <%= link_to "New billing", new_billing_path, class: "rounded-md px-3.5 py-2 bg-gray-100 hover:bg-gray-50 text-sm font-medium" %>
    </div>
  </div>

  <!-- Filters -->
  <div class="rounded-lg border border-gray-200 bg-white p-3 mb-6">
    <%= form_with url: billings_path, method: :get, local: true, class: "grid grid-cols-1 sm:grid-cols-4 gap-3" do %>
      <div class="sm:col-span-2">
        <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search statement # or patient…"
               class="w-full border rounded px-2 py-1.5" />
      </div>
      <div>
        <select name="status" class="w-full border rounded px-2 py-1.5">
          <option value="">All status</option>
          <% Billing.statuses.keys.each do |st| %>
            <option value="<%= st %>" <%= 'selected' if params[:status] == st %>><%= st.titleize %></option>
          <% end %>
        </select>
      </div>
      <div>
        <button class="w-full rounded-md px-3.5 py-1.5 bg-gray-900 text-white text-sm">Apply</button>
      </div>
    <% end %>
  </div>

  <% if @billings.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <%= render partial: "billings/billing_card", collection: @billings, as: :billing %>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-gray-600">
      No billings yet. <%= link_to "Create from checklists", new_from_checklists_billings_path, class: "text-blue-600 hover:underline" %>
    </div>
  <% end %>
</div>