<% content_for :title, "Billings" %>

<div class="max-w-7xl mx-auto">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-600 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="font-bold text-2xl">Billings</h1>
    <div class="flex gap-2">
      <%= link_to "New billing", new_billing_path, class: "btn btn-accent shadow-md" %>
    </div>
  </div>

  <!-- Filters -->
  <div class="rounded-lg border border-gray-200 bg-white p-3 mb-6 shadow-sm">
    <%= form_with url: billings_path, method: :get, local: true,
                  data: { controller: "debounced-submit", "debounced-submit-delay-value": 600, "debounced-submit-min-value": 3 },
                  class: "grid grid-cols-1 sm:grid-cols-3 gap-3" do %>
      <div class="sm:col-span-2">
        <div class="relative">
          <input type="text" name="q" value="<%= params[:q] %>" placeholder="Search statement # or patient…"
                 autocomplete="off" data-action="input->debounced-submit#input compositionstart->debounced-submit#compositionstart compositionend->debounced-submit#compositionend"
                 class="input input-bordered w-full pr-10" />
          <% if params[:q].present? || params[:status].present? %>
            <%= link_to billings_path,
                        class: "absolute top-1/2 -translate-y-1/2 right-3 text-gray-400 hover:text-gray-700",
                        title: "Clear", aria: { label: "Clear search" } do %>
              <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
            <% end %>
          <% end %>
        </div>
      </div>
      <div>
        <select name="status" class="select select-bordered w-full" data-action="change->debounced-submit#input">
          <option value="">All status</option>
          <% Billing.statuses.keys.each do |st| %>
            <option value="<%= st %>" <%= 'selected' if params[:status] == st %>><%= st.titleize %></option>
          <% end %>
        </select>
      </div>
      <!-- Apply button removed: debounced auto-submit in use -->
    <% end %>
  </div>

  <% if @billings.any? %>
    <div class="rounded-lg border border-gray-200 bg-white overflow-hidden shadow-md">
      <div class="overflow-x-auto">
        <table class="min-w-full text-sm">
          <thead class="bg-gray-50 text-gray-700">
            <tr>
              <th class="px-4 py-2 text-left uppercase tracking-wide text-xs font-semibold">Statement #</th>
              <th class="px-4 py-2 text-left uppercase tracking-wide text-xs font-semibold">Patient</th>
              <th class="px-4 py-2 text-left uppercase tracking-wide text-xs font-semibold">Date</th>
              <th class="px-4 py-2 text-right uppercase tracking-wide text-xs font-semibold">Total</th>
              <th class="px-4 py-2 text-left uppercase tracking-wide text-xs font-semibold">Status</th>
              <th class="px-4 py-2 text-right uppercase tracking-wide text-xs font-semibold">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <% @billings.each do |billing| %>
              <tr class="hover:bg-gray-50">
                <td class="px-4 py-2 whitespace-nowrap font-medium"><%= billing.statement_number %></td>
                <td class="px-4 py-2 whitespace-nowrap"><%= [billing.patient&.first_name, billing.patient&.last_name].compact.join(" ") %></td>
                <td class="px-4 py-2 whitespace-nowrap"><%= billing.statement_date %></td>
                <td class="px-4 py-2 whitespace-nowrap text-right"><%= number_to_currency(billing.total_cents.to_i / 100.0, unit: "₱") %></td>
                <td class="px-4 py-2 whitespace-nowrap">
                  <span class="text-xs px-2 py-0.5 rounded-full <%= {
                                                        'draft' => 'bg-amber-50 text-amber-700 ring-1 ring-amber-200',
                                                        'issued' => 'bg-green-50 text-green-700 ring-1 ring-green-200',
                                                        'void' => 'bg-red-50 text-red-700 ring-1 ring-red-200'
                                                      }[billing.status] %>"><%= billing.status.titleize %></span>
                </td>
                <td class="px-4 py-2 whitespace-nowrap text-right">
                  <div class="inline-flex items-center gap-1.5">
                    <%= link_to billing, class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900", title: "Show" do %>
                      <svg class="w-4 h-4" viewBox="0 0 22 22" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.04 12.32a11.45 11.45 0 0 1 19.92 0 11.45 11.45 0 0 1-19.92 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>
                    <% end %>
                    <%= link_to edit_billing_path(billing), class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900", title: "Edit" do %>
                      <svg class="w-4 h-4" viewBox="0 0 22 22" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 3.487a2.1 2.1 0 0 1 2.97 2.97L8.25 18.04 4.5 19.5l1.46-3.75 10.902-12.263z"/></svg>
                    <% end %>
                    <%= link_to billing_path(billing), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                                class: "inline-flex items-center justify-center rounded p-1.5 text-red-600 hover:bg-red-50", title: "Delete" do %>
                      <svg class="w-4 h-4" viewBox="0 0 22 22" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-9 0l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/></svg>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center text-gray-600">
      No billings yet. <%= link_to "Create from checklists", new_from_checklists_billings_path, class: "text-blue-600 hover:underline" %>
    </div>
  <% end %>
</div>