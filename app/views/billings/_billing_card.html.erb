<%# Billing card %>
<div class="rounded-lg border border-gray-200 bg-white p-4 shadow-sm hover:shadow transition">
  <div class="flex items-start justify-between gap-3">
    <div>
      <div class="text-sm text-gray-500">Statement #</div>
      <div class="font-semibold"><%= billing.statement_number %></div>
    </div>
    <span class="text-xs px-2 py-0.5 rounded-full <%= {
                                                        'draft' => 'bg-amber-50 text-amber-700 ring-1 ring-amber-200',
                                                        'issued' => 'bg-green-50 text-green-700 ring-1 ring-green-200',
                                                        'void' => 'bg-red-50 text-red-700 ring-1 ring-red-200'
                                                      }[billing.status] %>">
      <%= billing.status.titleize %>
    </span>
  </div>

  <div class="mt-3 text-sm">
    <div class="text-gray-600">
      <span class="font-medium text-gray-900"><%= [billing.patient&.first_name, billing.patient&.last_name].compact.join(" ") %></span>
    </div>
    <div class="text-gray-600">
      Period: <%= billing.period_start %> – <%= billing.period_end %>
    </div>
    <div class="text-gray-600">
      Date: <%= billing.statement_date %>
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between">
    <div class="text-sm">
      <div class="text-gray-500">Total</div>
      <div class="font-semibold"><%= number_to_currency(billing.total_cents.to_i / 100.0) %></div>
    </div>

    <div class="flex items-center gap-1.5">
      <%= link_to billing, class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900", title: "Show" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.04 12.32a11.45 11.45 0 0 1 19.92 0 11.45 11.45 0 0 1-19.92 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>
      <% end %>
      <%= link_to edit_billing_path(billing), class: "inline-flex items-center justify-center rounded p-1.5 text-gray-600 hover:bg-gray-100 hover:text-gray-900", title: "Edit" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16.862 3.487a2.1 2.1 0 0 1 2.97 2.97L8.25 18.04 4.5 19.5l1.46-3.75 10.902-12.263z"/></svg>
      <% end %>
      <%= link_to billing_path(billing), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" },
                  class: "inline-flex items-center justify-center rounded p-1.5 text-red-600 hover:bg-red-50", title: "Delete" do %>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 7h12M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2m-9 0l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/></svg>
      <% end %>
    </div>
  </div>
</div>